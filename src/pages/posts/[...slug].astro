---
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const postImports = import.meta.glob<{
    file: string;
    frontmatter: any;
    Content: any;
  }>('../../content/posts/*.md', { eager: true });

  const paths = Object.values(postImports).map((post) => {
    const filename = post.file.split('/').pop() || '';
    const fallbackSlug = filename.replace('.md', '');
    const slug = post.frontmatter.slug || fallbackSlug;

    return {
      params: { slug },
      props: { post },
    };
  });

  try {
    const redirectsJson = await import('../../../../data/slug-redirects.json', { assert: { type: 'json' } });
    const redirects = redirectsJson.default || {};
    for (const [oldSlug, newSlug] of Object.entries(redirects)) {
      paths.push({
        params: { slug: oldSlug },
        redirect: `/posts/${newSlug}`,
      });
    }
  } catch {
    // slug-redirects.json 不存在時は無視
  }

  return paths;
}

const { post } = Astro.props;
const { Content, frontmatter } = post;
---

<PostLayout frontmatter={frontmatter}>
  <Content />
</PostLayout>
