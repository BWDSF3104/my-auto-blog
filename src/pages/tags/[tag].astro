---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const postImports = import.meta.glob<{
    frontmatter: {
      title: string;
      pubDate: string;
      description: string;
      slug?: string;
      tags?: string[];
      image?: string;
    };
    url: string;
  }>('../../content/posts/*.md', { eager: true });

  const postRaw = import.meta.glob<string>('../../content/posts/*.md', { eager: true, query: 'raw' });

  function calcReadingTime(content: string): number {
    const stripped = content.replace(/^---[\s\S]*?---\s*/m, '');
    const jaLen = (stripped.match(/[\u3000-\u9FFF]/g) || []).length;
    return Math.max(1, Math.ceil(jaLen / 1500));
  }

  const tagMap = new Map<string, typeof postImports>();
  Object.entries(postImports).forEach(([path, module]) => {
    module.frontmatter.tags?.forEach(tag => {
      if (!tagMap.has(tag)) tagMap.set(tag, {});
      tagMap.get(tag)![path] = module;
    });
  });

  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

  return Array.from(tagMap.keys()).map(tag => {
    const tagPosts = Object.entries(tagMap.get(tag)!).map(([path, module]) => {
      const filename = path.split('/').pop()?.replace('.md', '') || '';
      const slug = module.frontmatter.slug || filename;
      const raw = ((postRaw[path] as any)?.default as string) || '';
      const readingTime = calcReadingTime(raw);
      return {
        frontmatter: module.frontmatter,
        url: `${baseUrl}/posts/${slug}`,
        readingTime
      };
    });
    tagPosts.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());

    return {
      params: { tag },
      props: { tag, posts: tagPosts }
    };
  });
}

const { tag, posts } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = `#${tag} | BWD's AI Auto Blog`;
const siteDescription = `"${tag}"タグの記事一覧（${posts.length}件）`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="google-site-verification" content="1mHkEb2UNbzsWZB98HrQVu2oI62PzkMBsMVVed8Kwug" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BWD's AI Auto Blog" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "headline": `#${tag}`,
      "description": siteDescription,
      "url": canonicalURL.href,
      "partOfSeries": {
        "@type": "WebSite",
        "@id": `${canonicalURL.origin}${baseUrl}/`
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "ホーム", "item": `${canonicalURL.origin}${baseUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "タグ一覧", "item": `${canonicalURL.origin}${baseUrl}/tags/` },
        { "@type": "ListItem", "position": 3, "name": `#${tag}` }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BWD's AI Auto Blog",
      "url": `${canonicalURL.origin}${baseUrl}/`,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${canonicalURL.origin}${baseUrl}/tags/{search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
  </head>
  <body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 antialiased min-h-screen py-10 px-4 font-[system-ui,-apple-system,BlinkMacSystemFont,'Segoe_UI',Roboto,sans-serif]">
    <div class="max-w-3xl mx-auto">
      <header class="border-b-2 border-slate-200 dark:border-slate-700 mb-10 pb-6">
        <nav aria-label="パンくずリスト">
          <ol class="list-none p-0 m-0 mb-4 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
            <li><a href={baseUrl} class="text-slate-500 dark:text-slate-400 no-underline hover:text-blue-600 dark:hover:text-blue-400 transition-colors">ホーム</a></li>
            <li>›</li>
            <li><a href={`${baseUrl}/tags`} class="text-slate-500 dark:text-slate-400 no-underline hover:text-blue-600 dark:hover:text-blue-400 transition-colors">タグ一覧</a></li>
            <li>›</li>
            <li><span class="font-medium text-slate-700 dark:text-slate-200">#{tag}</span></li>
          </ol>
        </nav>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href={baseUrl} class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors no-underline">
            ← 記事一覧に戻る
          </a>
          <a href={`${baseUrl}/tags`} class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors no-underline">
            → 全タグを見る
          </a>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight mb-2">#{tag}</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base">{posts.length}件の記事</p>
      </header>

      <main>
        {posts.length === 0 ? (
          <p>記事が見つかりません。</p>
        ) : (
          <ul class="list-none p-0 m-0 space-y-6">
            {posts.map((post) => (
              <li class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
                <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                  {post.frontmatter.image && (
                    <a href={post.url} class="block flex-shrink-0">
                      <img
                        src={post.frontmatter.image}
                        alt={post.frontmatter.title}
                        class="w-full h-40 sm:w-44 sm:h-28 object-cover rounded-lg border border-slate-200 dark:border-slate-600"
                        loading="lazy"
                      />
                    </a>
                  )}
                  <div class="flex-1 min-w-0">
                    <h2 class="text-xl font-bold m-0 mb-2">
                      <a href={post.url} class="text-blue-600 dark:text-blue-400 no-underline hover:underline">{post.frontmatter.title}</a>
                    </h2>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500 dark:text-slate-400 mb-3">
                      <span>📅 {post.frontmatter.pubDate}</span>
                      <span>📖 {post.readingTime}分</span>
                      {post.frontmatter.tags && post.frontmatter.tags.map((t: string) => (
                        <a href={`${baseUrl}/tags/${encodeURIComponent(t)}`} class="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-2 py-0.5 rounded text-xs font-semibold hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors no-underline">#{t}</a>
                      ))}
                    </div>
                    <p class="m-0 text-slate-600 dark:text-slate-300 text-sm">{post.frontmatter.description}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )}
      </main>

      <Footer />
    </div>
  </body>
</html>
