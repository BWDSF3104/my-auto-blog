---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const postImports = import.meta.glob<{
  frontmatter: {
    title: string;
    pubDate: string;
    description: string;
    slug?: string;
    tags?: string[];
    image?: string;
  };
  url: string;
}>('../../content/posts/*.md', { eager: true });

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const tagMap = new Map<string, number>();
const posts = Object.entries(postImports).map(([path, module]) => {
  const filename = path.split('/').pop()?.replace('.md', '') || '';
  const slug = module.frontmatter.slug || filename;
  module.frontmatter.tags?.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
  return {
    frontmatter: module.frontmatter,
    url: `${baseUrl}/posts/${slug}`
  };
});

posts.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());

const tags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);

const pageTitle = "タグ一覧 | BWD's AI Auto Blog";
const siteDescription = "ブログ記事のタグ別一覧ページ";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="google-site-verification" content="1mHkEb2UNbzsWZB98HrQVu2oI62PzkMBsMVVed8Kwug" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BWD's AI Auto Blog" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "headline": "タグ一覧",
      "description": siteDescription,
      "url": canonicalURL.href,
      "partOfSeries": {
        "@type": "WebSite",
        "@id": `${canonicalURL.origin}${baseUrl}/`
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "ホーム", "item": `${canonicalURL.origin}${baseUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "タグ一覧" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BWD's AI Auto Blog",
      "url": `${canonicalURL.origin}${baseUrl}/`,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${canonicalURL.origin}${baseUrl}/tags/{search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
  </head>
  <body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 antialiased min-h-screen py-10 px-4 font-[system-ui,-apple-system,BlinkMacSystemFont,'Segoe_UI',Roboto,sans-serif]">
    <div class="max-w-3xl mx-auto">
      <header class="border-b-2 border-slate-200 dark:border-slate-700 mb-10 pb-6">
        <nav aria-label="パンくずリスト">
          <ol class="list-none p-0 m-0 mb-4 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
            <li><a href={baseUrl} class="text-slate-500 dark:text-slate-400 no-underline hover:text-blue-600 dark:hover:text-blue-400 transition-colors">ホーム</a></li>
            <li>›</li>
            <li><span class="font-medium text-slate-700 dark:text-slate-200">タグ一覧</span></li>
          </ol>
        </nav>
        <a href={baseUrl} class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 mb-6 transition-colors no-underline">
          ← 記事一覧に戻る
        </a>
        <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight mb-2">タグ一覧</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base">全 {tags.length} タグ · {posts.length} 記事</p>

        <div class="mt-6">
          <input
            type="text"
            id="tag-search"
            placeholder="タグを検索..."
            class="w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg text-sm text-slate-800 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow"
          />
        </div>
      </header>

      <main>
        <ul id="tag-list" class="flex flex-wrap gap-3 list-none p-0 m-0">
          {tags.map(([name, count]) => (
            <li class="tag-item bg-white dark:bg-slate-800 rounded-xl p-3 border border-slate-200 dark:border-slate-700 shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-200" data-tag={name.toLowerCase()}>
              <a href={`${baseUrl}/tags/${encodeURIComponent(name)}`} class="text-lg font-semibold text-blue-600 dark:text-blue-400 no-underline hover:underline">#{name}</a>
              <span class="text-xs text-slate-500 dark:text-slate-400 ml-2">({count})</span>
            </li>
          ))}
        </ul>
        <p id="no-results" class="hidden text-center text-slate-500 dark:text-slate-400 py-10">該当するタグが見つかりません。</p>
      </main>

      <Footer />
    </div>
  </body>
</html>

<script>
  const searchInput = document.getElementById('tag-search');
  const tagList = document.getElementById('tag-list');
  const noResults = document.getElementById('no-results');
  const tagItems = tagList.querySelectorAll('.tag-item');

  searchInput.addEventListener('input', function() {
    const query = this.value.toLowerCase().trim();
    let visibleCount = 0;

    tagItems.forEach(item => {
      const tag = item.getAttribute('data-tag');
      if (tag.includes(query)) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (visibleCount === 0 && query) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  });
</script>
