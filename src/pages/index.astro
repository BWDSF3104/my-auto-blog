---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const POSTS_PER_PAGE = 10;

const postImports = import.meta.glob<{
  frontmatter: {
    title: string;
    pubDate: string;
    description: string;
    slug?: string;
    tags?: string[];
    image?: string;
  };
  url: string;
}>('../content/posts/*.md', { eager: true });

const postRaw = import.meta.glob<string>('../content/posts/*.md', { eager: true, query: 'raw' });

function calcReadingTime(content: string): number {
  const stripped = content.replace(/^---[\s\S]*?---\s*/m, '');
  const jaLen = (stripped.match(/[\u3000-\u9FFF]/g) || []).length;
  return Math.max(1, Math.ceil(jaLen / 1500));
}

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPosts = Object.entries(postImports).map(([path, module]) => {
  const filename = path.split('/').pop()?.replace('.md', '') || '';
  const slug = module.frontmatter.slug || filename;
  const raw = ((postRaw[path] as any)?.default as string) || '';
  const readingTime = calcReadingTime(raw);
  return {
    frontmatter: module.frontmatter,
    url: `${baseUrl}/posts/${slug}`,
    readingTime
  };
});

allPosts.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE) || 1;
const posts = allPosts.slice(0, POSTS_PER_PAGE);

const pageTitle = "BWD's AI Auto Blog";
const siteDescription = "Gemini API × GitHub Actions による自動生成技術＆ストーリーブログ";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = posts[0]?.frontmatter.image
  ? (posts[0].frontmatter.image.startsWith('http') ? posts[0].frontmatter.image : new URL(posts[0].frontmatter.image, Astro.site).href)
  : new URL(`${baseUrl}/favicon.svg`, Astro.site).href;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="icon" href={`${baseUrl}/favicon.ico`} />
    <link rel="alternate" type="application/rss+xml" title={`${pageTitle} RSS Feed`} href={`${baseUrl}/rss.xml`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="google-site-verification" content="1mHkEb2UNbzsWZB98HrQVu2oI62PzkMBsMVVed8Kwug" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BWD's AI Auto Blog" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BWD's AI Auto Blog",
      "url": `${canonicalURL.origin}${baseUrl}/`,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${canonicalURL.origin}${baseUrl}/tags/{search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "BWD's AI Auto Blog",
      "description": siteDescription,
      "url": `${canonicalURL.origin}${baseUrl}/`,
      "mainEntity": posts.map((post, i) => ({
        "@type": "BlogPosting",
        "headline": post.frontmatter.title,
        "description": post.frontmatter.description,
        "datePublished": post.frontmatter.pubDate,
        "url": new URL(post.url, canonicalURL).href,
        "position": i + 1
      }))
    })} />
  </head>
  <body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 antialiased min-h-screen py-10 px-4 font-[system-ui,-apple-system,BlinkMacSystemFont,'Segoe_UI',Roboto,sans-serif]">
    <div class="max-w-3xl mx-auto">
      <Header />

      <main>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">全 {allPosts.length} 件中 1–{Math.min(POSTS_PER_PAGE, allPosts.length)} を表示</p>

        {allPosts.length === 0 ? (
          <p>記事が見つかりません。</p>
        ) : (
          <ul class="list-none p-0 m-0 space-y-6">
            {posts.map((post) => (
              <li class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
                <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                  {post.frontmatter.image && (
                    <a href={post.url} class="block flex-shrink-0">
                      <img
                        src={post.frontmatter.image}
                        alt={post.frontmatter.title}
                         class="w-full h-[160px] sm:w-[180px] sm:h-[120px] object-cover rounded-lg border border-slate-200 dark:border-slate-600"
                        loading="lazy"
                      />
                    </a>
                  )}
                  <div class="flex-1 min-w-0">
                    <h2 class="text-xl font-bold m-0 mb-2">
                      <a href={post.url} class="text-blue-600 dark:text-blue-400 no-underline hover:underline">{post.frontmatter.title}</a>
                    </h2>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500 dark:text-slate-400 mb-3">
                      <span>📅 {post.frontmatter.pubDate}</span>
                      <span>📖 {post.readingTime}分</span>
                      {post.frontmatter.tags && post.frontmatter.tags.map((tag: string) => (
                        <a href={`${baseUrl}/tags/${encodeURIComponent(tag)}`} class="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-2 py-0.5 rounded text-xs font-semibold hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors no-underline">#{tag}</a>
                      ))}
                    </div>
                    <p class="m-0 text-slate-600 dark:text-slate-300 text-sm">{post.frontmatter.description}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )}

        {totalPages > 1 && (
          <nav class="flex items-center justify-center gap-2 mt-10" aria-label="ページネーション">
            <span
              class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold"
              aria-current="page"
            >
              1
            </span>

            {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map(page => (
              <a
                href={`${baseUrl}/page/${page}`}
                class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 no-underline hover:bg-slate-50 dark:hover:bg-slate-700 hover:border-slate-300 dark:hover:border-slate-600 transition-colors"
                aria-label={`ページ ${page}`}
              >
                {page}
              </a>
            ))}

            <a
              href={`${baseUrl}/page/2`}
              class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 no-underline hover:bg-slate-50 dark:hover:bg-slate-700 hover:border-slate-300 dark:hover:border-slate-600 transition-colors"
              aria-label="次のページ"
            >
              次 →
            </a>
          </nav>
        )}
      </main>

      <Footer />
    </div>
  </body>
</html>
