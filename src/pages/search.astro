---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { getTagColor } from '../lib/tagColors';
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = "検索 | BWD's AI Auto Blog";
const query = Astro.url.searchParams.get('q') || '';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content="ブログ記事を検索" />
    <meta name="google-site-verification" content="1mHkEb2UNbzsWZB98HrQVu2oI62PzkMBsMVVed8Kwug" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BWD's AI Auto Blog" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <ThemeInit />
  </head>
  <body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 antialiased min-h-screen py-10 px-4 font-[system-ui,-apple-system,BlinkMacSystemFont,'Segoe_UI',Roboto,sans-serif]">
    <a href="#main-content" class="skip-link">スキップナビゲーション</a>
    <div class="max-w-3xl mx-auto">
      <Header />

      <main id="main-content">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-6">検索</h1>

        <div class="flex gap-3 mb-8">
          <input
            id="search-input"
            type="search"
            placeholder="記事を検索..."
            value={query}
            class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow text-base"
          />
          <button
            id="search-btn"
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold text-sm transition-colors flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            検索
          </button>
        </div>

        <div id="search-status" class="text-sm text-slate-500 dark:text-slate-400 mb-4"></div>

        <div id="search-results" class="list-none p-0 m-0 space-y-4"></div>

        <div id="no-results" class="hidden text-center py-16">
          <p class="text-slate-500 dark:text-slate-400 text-lg">該当する記事が見つかりません</p>
        </div>
      </main>

      <Footer />
    </div>
  </body>
</html>

<script is:inline>
(function () {
  var index = [];
  var input = document.getElementById('search-input');
  var btn = document.getElementById('search-btn');
  var resultsEl = document.getElementById('search-results');
  var statusEl = document.getElementById('search-status');
  var noResultsEl = document.getElementById('no-results');
  var baseUrl = '{baseUrl}';
  var initialQuery = (new URLSearchParams(window.location.search)).get('q') || '';

  function escapeHtml(text) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(text));
    return div.innerHTML;
  }

  function highlightText(text, query) {
    if (!query) return escapeHtml(text);
    var escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    var regex = new RegExp('(' + escaped + ')', 'gi');
    return escapeHtml(text).replace(new RegExp('(' + escaped.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi'), '<mark class="bg-yellow-200 dark:bg-yellow-700 text-inherit rounded px-0.5">$1</mark>');
  }

  function getSnippet(body, query, contextLen) {
    contextLen = contextLen || 80;
    if (!query) return '';
    var lowerBody = body.toLowerCase();
    var lowerQuery = query.toLowerCase();
    var pos = lowerBody.indexOf(lowerQuery);
    if (pos === -1) return body.slice(0, contextLen * 2 + 10);
    var start = Math.max(0, pos - contextLen);
    var end = Math.min(body.length, pos + query.length + contextLen);
    var snippet = body.slice(start, end);
    if (start > 0) snippet = '...' + snippet;
    if (end < body.length) snippet = snippet + '...';
    return snippet;
  }

  function formatDate(dateStr) {
    return dateStr;
  }

  function renderResults(posts, query) {
    resultsEl.innerHTML = '';
    if (posts.length === 0) {
      noResultsEl.classList.remove('hidden');
      resultsEl.classList.add('hidden');
      if (query) {
        statusEl.textContent = query + ' の検索結果：0件';
      } else {
        statusEl.textContent = '';
      }
      return;
    }
    noResultsEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');
    statusEl.textContent = query ? query + ' の検索結果：' + posts.length + '件' : posts.length + '件の記事';

    var fragment = document.createDocumentFragment();
    posts.forEach(function (post) {
      var li = document.createElement('li');
      li.className = 'bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-200';

      var link = document.createElement('a');
      link.href = baseUrl + '/posts/' + post.slug;
      link.className = 'no-underline';

      var titleDiv = document.createElement('h2');
      titleDiv.className = 'text-xl font-bold m-0 mb-2 text-blue-600 dark:text-blue-400 hover:underline';
      titleDiv.innerHTML = highlightText(post.title, query);
      link.appendChild(titleDiv);

      var metaDiv = document.createElement('div');
      metaDiv.className = 'flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500 dark:text-slate-400 mb-3';

      var dateSpan = document.createElement('span');
      dateSpan.textContent = '\u{1F4C5} ' + formatDate(post.pubDate);
      metaDiv.appendChild(dateSpan);

      if (post.tags && post.tags.length) {
        post.tags.forEach(function (tag) {
          var tagLink = document.createElement('a');
          tagLink.href = baseUrl + '/tags/' + encodeURIComponent(tag);
          tagLink.className = 'px-2 py-0.5 rounded text-xs font-semibold no-underline bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors';
          tagLink.textContent = '#' + tag;
          metaDiv.appendChild(tagLink);
        });
      }
      link.appendChild(metaDiv);

      if (query) {
        var snippet = getSnippet(post.body, query);
        if (snippet) {
          var p = document.createElement('p');
          p.className = 'm-0 text-slate-600 dark:text-slate-300 text-sm';
          p.innerHTML = highlightText(snippet, query);
          link.appendChild(p);
        }
      } else {
        var excerptP = document.createElement('p');
        excerptP.className = 'm-0 text-slate-600 dark:text-slate-300 text-sm';
        excerptP.textContent = post.excerpt;
        link.appendChild(excerptP);
      }

      li.appendChild(link);
      fragment.appendChild(li);
    });
    resultsEl.appendChild(fragment);
  }

  function search(query) {
    query = query.trim();
    if (!query) {
      renderResults(index, '');
      updateUrl('');
      return;
    }
    var lowerQuery = query.toLowerCase();
    var words = lowerQuery.split(/\s+/).filter(function (w) { return w.length > 0; });

    var scored = index.map(function (post) {
      var score = 0;
      var titleMatch = false;
      var tagMatch = false;

      words.forEach(function (word) {
        var lowerTitle = post.title.toLowerCase();
        var lowerBody = post.body.toLowerCase();

        if (lowerTitle.indexOf(word) !== -1) {
          score += 10;
          titleMatch = true;
        }
        if (lowerBody.indexOf(word) !== -1) {
          score += 1;
        }
        if (post.tags) {
          post.tags.forEach(function (tag) {
            if (tag.toLowerCase().indexOf(word) !== -1) {
              score += 5;
              tagMatch = true;
            }
          });
        }
      });

      return { post: post, score: score, titleMatch: titleMatch, tagMatch: tagMatch };
    }).filter(function (item) { return item.score > 0; });

    scored.sort(function (a, b) {
      if (b.titleMatch && !a.titleMatch) return 1;
      if (!b.titleMatch && a.titleMatch) return -1;
      return b.score - a.score;
    });

    var results = scored.map(function (item) { return item.post; });
    renderResults(results, query);
    updateUrl(query);
  }

  function updateUrl(query) {
    var url = new URL(window.location.href);
    if (query) {
      url.searchParams.set('q', query);
    } else {
      url.searchParams.delete('q');
    }
    history.replaceState(null, '', url);
  }

  function loadIndex() {
    fetch(baseUrl + '/search-index.json')
      .then(function (res) { return res.json(); })
      .then(function (data) {
        index = data;
        if (initialQuery) {
          search(initialQuery);
        } else {
          renderResults(index, '');
        }
      })
      .catch(function (err) {
        statusEl.textContent = '検索インデックスの読み込みに失敗しました。';
        console.error('Failed to load search index:', err);
      });
  }

  input.addEventListener('input', function () {
    search(input.value);
  });

  btn.addEventListener('click', function () {
    search(input.value);
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      search(input.value);
    }
  });

  loadIndex();
})();
</script>
