---
import Header from '../components/Header.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { getTagColor } from '../lib/tagColors';
import '../styles/global.css';

interface Props {
  frontmatter: {
    title: string;
    pubDate: string;
    description: string;
    tags?: string[];
    author?: string;
    image?: string;
    slug?: string;
    modifiedDate?: string;
    prompt_type?: string;
    [key: string]: any;
  };
}

const { frontmatter } = Astro.props;

// サイトURL & OGP設定
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = "BWD's AI Auto Blog";
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');

// 関連記事を取得
const postImports = import.meta.glob<{
  frontmatter: {
    title: string;
    pubDate: string;
    description: string;
    slug?: string;
    tags?: string[];
    image?: string;
  };
  url: string;
}>('../content/posts/*.md', { eager: true });

const currentSlug = frontmatter.slug || Astro.url.pathname.split('/').pop() || '';
const allPosts = Object.entries(postImports).map(([path, module]) => {
  const filename = path.split('/').pop()?.replace('.md', '') || '';
  const slug = module.frontmatter.slug || filename;
  if (!module.frontmatter.title) {
    return null;
  }
  return {
    frontmatter: module.frontmatter,
    slug,
    url: `${basePrefix}/posts/${slug}`
  };
}).filter(post => post != null && post.slug !== currentSlug);

// タグでスコア付けして関連記事を抽出
const scoredPosts = allPosts.map(post => {
  const sharedTags = post.frontmatter.tags?.filter(tag => frontmatter.tags?.includes(tag)) || [];
  return { ...post, score: sharedTags.length };
}).filter(post => post.score > 0)
  .sort((a, b) => b.score - a.score || new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
  .slice(0, 3);
const ogImageUrl = frontmatter.image
  ? (frontmatter.image.startsWith('http') ? frontmatter.image : new URL(frontmatter.image, Astro.site).href)
  : new URL(`${basePrefix}/favicon.svg`, Astro.site).href;

// OG画像のtype/width/heightを推論
const ogImageExt = ogImageUrl.split('.').pop()?.split('?')[0]?.toLowerCase() || '';
const ogImageType = ogImageExt === 'svg' ? 'image/svg+xml'
  : ogImageExt === 'png' ? 'image/png'
  : ogImageExt === 'jpg' || ogImageExt === 'jpeg' ? 'image/jpeg'
  : ogImageExt === 'webp' ? 'image/webp'
  : ogImageExt === 'avif' ? 'image/avif'
  : 'image/png';
const ogImageWidth = frontmatter.image ? '1200' : '512';
const ogImageHeight = frontmatter.image ? '630' : '512';

// 収益化・アフィリエイト・投げ銭設定
const bmcUsername = import.meta.env.PUBLIC_BUYMEACOFFEE_USERNAME || "bwdsf3104";
const amazonTag = import.meta.env.PUBLIC_AMAZON_TAG || "your-amazon-tag-22";
const rakutenId = import.meta.env.PUBLIC_RAKUTEN_ID || "your-rakuten-id";

// 関連検索キーワード（タグまたはタイトルから抽出）
const relatedKeyword = frontmatter.tags && frontmatter.tags.length > 0
  ? frontmatter.tags[0]
  : (frontmatter.title?.split(' ')[0] || 'AI');

const amazonSearchUrl = `https://www.amazon.co.jp/s?k=${encodeURIComponent(relatedKeyword)}&tag=${encodeURIComponent(amazonTag)}`;
const rakutenSearchUrl = `https://search.rakuten.co.jp/search/mall/${encodeURIComponent(relatedKeyword)}/?scid=${encodeURIComponent(rakutenId)}`;

// JSON-LD 構造化データ (SEO)
const schemaOrgJSONLD = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": frontmatter.title,
  "description": frontmatter.description,
  "datePublished": frontmatter.pubDate,
  "author": {
    "@type": "Person",
    "name": frontmatter.author || "AI Writer"
  },
  "image": ogImageUrl,
  "url": canonicalURL.href
};

// BreadcrumbList JSON-LD
const breadcrumbJSONLD = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": `${canonicalURL.origin}${basePrefix}/` },
    { "@type": "ListItem", "position": 2, "name": "記事一覧", "item": `${canonicalURL.origin}${basePrefix}/` },
    { "@type": "ListItem", "position": 3, "name": frontmatter.title }
  ]
};

// FAQPage JSON-LD (frontmatterの faq フィールドから解析)
let faqJSONLD: object | undefined;
if (frontmatter.faq) {
  const faqRaw = String(frontmatter.faq).trim();
  let faqList: { question: string; answer: string }[] = [];
  try {
    const parsed = JSON.parse(faqRaw);
    if (Array.isArray(parsed)) {
      faqList = parsed.filter((item: any) => item.question && item.answer);
    }
  } catch { /* ignore parse errors */ }
  if (faqList.length) {
    faqJSONLD = {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqList.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    };
  }
}

// Speakable JSON-LD (frontmatterの speakable フィールドから)
let speakableJSONLD: object | undefined;
if (frontmatter.speakable) {
  speakableJSONLD = {
    "@context": "https://schema.org",
    "@type": "Speakable",
    "url": canonicalURL.href,
    "cssSelector": ["article p:first-of-type"]
  };
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${basePrefix}/favicon.svg`} />
    <link rel="icon" href={`${basePrefix}/favicon.ico`} />
    <link rel="preconnect" href="https://cdn.buymeacoffee.com" />
    {frontmatter.image && (
      <link rel="preload" as="image" href={frontmatter.image} fetchpriority="high" />
    )}

    <ThemeInit />
    <title>{frontmatter.title} | {siteTitle}</title>
    <meta name="description" content={frontmatter.description} />
    <meta name="google-site-verification" content="1mHkEb2UNbzsWZB98HrQVu2oI62PzkMBsMVVed8Kwug" />

    <!-- OGP (Open Graph Protocol) -->
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="article:published_time" content={frontmatter.pubDate} />
    {frontmatter.modifiedDate && (
      <meta property="article:modified_time" content={frontmatter.modifiedDate} />
    )}
    {frontmatter.tags && frontmatter.tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={frontmatter.title} />
    <meta name="twitter:description" content={frontmatter.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD (SEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgJSONLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJSONLD)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BWD's AI Auto Blog",
      "url": `${canonicalURL.origin}${basePrefix}/`,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${canonicalURL.origin}${basePrefix}/tags/{search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    {faqJSONLD && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJSONLD)} />
    )}
    {speakableJSONLD && (
      <script type="application/ld+json" set:html={JSON.stringify(speakableJSONLD)} />
    )}
  </head>
  <body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 antialiased min-h-screen py-10 px-4">
    <a href="#main-content" class="skip-link">スキップナビゲーション</a>
    <div class="max-w-3xl lg:max-w-6xl mx-auto">
      <Header />
      <div class="flex flex-col lg:flex-row-reverse gap-6 lg:gap-8 items-start">
      <!-- 目次 (TOC) - lg以上で右サイドバーに固定 -->
      <nav class="toc-nav w-full mb-8 p-4 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 lg:sticky lg:top-24 lg:w-64 lg:flex-shrink-0 lg:order-1" aria-label="目次">
        <h2 class="toc-title text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-3">目次</h2>
        <ol class="toc-list text-sm text-slate-600 dark:text-slate-300 space-y-1.5">
        </ol>
      </nav>
      <main id="main-content" class="w-full lg:flex-1 lg:order-2" class="bg-white dark:bg-slate-800 p-6 sm:p-10 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700">
      <nav class="mb-4" aria-label="パンくずリスト">
        <ol class="flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400">
          <li><a href={basePrefix} class="text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">ホーム</a></li>
          <li>›</li>
          <li><span class="font-medium text-slate-700 dark:text-slate-200">{frontmatter.title}</span></li>
        </ol>
      </nav>
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 mb-6 transition-colors">
        ← 記事一覧に戻る
      </a>
      
      <header class="mb-8 pb-6 border-b border-slate-200 dark:border-slate-700">
        <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight mb-4">
          {frontmatter.title}
        </h1>
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400 mb-6">
          <time datetime={frontmatter.pubDate}>📅 {frontmatter.pubDate}</time>
          <span>✍️ {frontmatter.author}</span>
          {frontmatter.tags && (
            <div class="flex flex-wrap gap-1.5 ml-auto">
              {frontmatter.tags.map((tag: string) => {
                const c = getTagColor(tag);
                return <a href={`${basePrefix}/tags/${encodeURIComponent(tag)}`} class={`${c.bg} ${c.darkBg} ${c.text} ${c.darkText} px-2.5 py-0.5 rounded-full text-xs font-semibold ${c.hover} ${c.darkHover} transition-colors no-underline`}>
                  #{tag}
                </a>;
              })}
            </div>
          )}
        </div>

      {/* アイキャッチ画像 */}
      {frontmatter.image && (
        <img
          src={frontmatter.image}
          alt={frontmatter.title}
          width="896"
          height="512"
          fetchpriority="high"
          decoding="async"
          class="post-image"
        />
      )}
      </header>

      <article class="prose prose-slate max-w-none text-left prose-headings:font-bold prose-a:text-blue-600 prose-pre:bg-slate-900 dark:prose-invert dark:prose-headings:text-slate-100 dark:prose-p:text-slate-300 dark:prose-li:text-slate-300 dark:prose-strong:text-slate-200 dark:prose-em:text-slate-200 dark:prose-a:text-blue-400 dark:prose-code:text-amber-300 dark:prose-code:bg-slate-700 dark:prose-pre:bg-slate-950 dark:prose-blockquote:text-slate-300 dark:prose-figcaption:text-slate-400" id="article-content">
        <slot />
      </article>

      <!-- 関連記事 -->
      {scoredPosts.length > 0 && (
        <section class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4">関連記事</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {scoredPosts.map((post) => (
              <a href={post.url} class="group flex gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700 hover:bg-blue-50 dark:hover:bg-slate-600 hover:border-blue-200 dark:hover:border-blue-800 transition-colors no-underline">
                {post.frontmatter.image && (
                  <img
                    src={post.frontmatter.image}
                    alt={post.frontmatter.title}
                    class="w-20 h-14 object-cover rounded-lg border border-slate-200 dark:border-slate-600 flex-shrink-0"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">
                    {post.frontmatter.title}
                  </p>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{post.frontmatter.pubDate}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- 関連商品・アフィリエイトエリア（フォールバック: 本文にアフィリエイトブロックがない場合のみ表示） -->
      <section class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-700 affiliate-fallback">
        <h3 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">
          関連する商品・書籍を探す
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href={amazonSearchUrl}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="affiliate-link flex items-center justify-between p-3.5 rounded-xl border border-amber-200 bg-amber-50/60 hover:bg-amber-100/80 transition-colors text-amber-900 font-medium text-sm shadow-xs no-underline"
            data-platform="amazon"
            data-keyword={relatedKeyword}
          >
            <span class="min-w-0 break-words">📦 Amazonで「{relatedKeyword}」を探す</span>
            <span class="text-xs text-amber-700 bg-amber-200/60 px-2 py-0.5 rounded-full">PR ↗</span>
          </a>
          <a
            href={rakutenSearchUrl}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="affiliate-link flex items-center justify-between p-3.5 rounded-xl border border-rose-200 bg-rose-50/60 hover:bg-rose-100/80 transition-colors text-rose-900 font-medium text-sm shadow-xs no-underline"
            data-platform="rakuten"
            data-keyword={relatedKeyword}
          >
            <span class="min-w-0 break-words">🛍️ 楽天市場で「{relatedKeyword}」を探す</span>
            <span class="text-xs text-rose-700 bg-rose-200/60 px-2 py-0.5 rounded-full">PR ↗</span>
          </a>
        </div>
      </section>

      <!-- 記事末尾のサポートエリア（Buy Me a Coffee） -->
      <div class="support-box mt-8 p-6 border border-slate-200 dark:border-slate-700 rounded-xl bg-slate-50 dark:bg-slate-800 text-center shadow-xs">
        <p class="text-sm sm:text-base font-medium text-slate-700 dark:text-slate-300 mb-4">
          この記事が役に立ったら、著者をサポートしていただけると励みになります！
        </p>
        <a href={`https://www.buymeacoffee.com/${bmcUsername}`} target="_blank" rel="noopener noreferrer" class="inline-block transition-transform hover:scale-105 active:scale-95">
          <img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me A Coffee" style="height: 50px; width: 217px;" class="mx-auto" />
        </a>
      </div>

      <!-- Social Sharing Buttons -->
      <section class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-700">
        <h3 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4 text-center">この記事を共有する</h3>
        <div class="flex items-center justify-center gap-3">
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(frontmatter.title)}&url=${encodeURIComponent(canonicalURL.href)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 rounded-full bg-sky-500 hover:bg-sky-600 text-white transition-colors" aria-label="X (Twitter)で共有" title="X (Twitter)で共有">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.141 18.01H19.56l-14.15-18.01H5.86z"/></svg>
          </a>
          <a href={`https://b.hatena.ne.jp/entry/${encodeURIComponent(canonicalURL.href)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 rounded-full bg-pink-500 hover:bg-pink-600 text-white transition-colors" aria-label="はてなブックマークで共有" title="はてなブックマークで共有">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.5 4.5v4.05c2.5.15 4.5 1.07 4.5 2.45 0 1.38-2 2.3-4.5 2.45v2.05h-1.5v-2.05c-2.5-.15-4.5-1.07-4.5-2.45 0-1.38 2-2.3 4.5-2.45V6.5h1.5z"/></svg>
          </a>
          <a href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(canonicalURL.href)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 rounded-full bg-green-500 hover:bg-green-600 text-white transition-colors" aria-label="LINEで共有" title="LINEで共有">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.527 3.66 1.44 5.16L2.5 22l5.07-1.33A9.94 9.94 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm5.58 13.12c-.15.42-.9.75-1.35.75-.22 0-.44-.03-.66-.1l-.2-.06-.06.2c-.15.5-.37.98-.66 1.42l-.12.18-.18-.12c-.44-.3-1.02-.75-1.56-1.28-.74-.72-1.32-1.48-1.74-2.26-.5-.96-.75-1.9-.75-2.78 0-.12.02-.24.06-.36l.06-.2.2-.06c.42-.15.75-.9.75-1.35 0-.22-.03-.44-.1-.66l-.06-.2.12-.18c.3-.44.75-1.02 1.28-1.56.72-.74 1.48-1.32 2.26-1.74.96-.5 1.9-.75 2.78-.75.12 0 .24.02.36.06l.2.06.06.2c.15.42.9.75 1.35.75.22 0 .44-.03.66-.1l.2-.06.06.2c.15.5.37.98.66 1.42l.12.18.18-.12c.44-.3 1.02-.75 1.56-1.28.72-.74 1.32-1.48 1.74-2.26.5-.96.75-1.9.75-2.78 0-.12-.02-.24-.06-.36l-.06-.2-.2-.06c-.42-.15-.75-.9-.75-1.35z"/></svg>
          </a>
          <a href={`https://getpocket.com/save?url=${encodeURIComponent(canonicalURL.href)}&title=${encodeURIComponent(frontmatter.title)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 rounded-full bg-red-600 hover:bg-red-700 text-white transition-colors" aria-label="Pocketに保存" title="Pocketに保存">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h12a4 4 0 014 4v12a4 4 0 01-4 4H6a4 4 0 01-4-4V6a4 4 0 014-4zm1.5 3a2.5 2.5 0 00-2.5 2.5v2a2.5 2.5 0 005 0v-2A2.5 2.5 0 007.5 5zm9 0a2.5 2.5 0 00-2.5 2.5v2a2.5 2.5 0 005 0v-2A2.5 2.5 0 0016.5 5zM7.5 12a1 1 0 011 1v4a1 1 0 01-2 0v-4a1 1 0 011-1zm9 0a1 1 0 011 1v4a1 1 0 01-2 0v-4a1 1 0 011-1z"/></svg>
          </a>
        </div>
      </section>
    </main>
      </div>

    <button
      id="back-to-top"
      aria-label="ページの先頭に戻る"
      title="ページの先頭に戻る"
      class="back-to-top fixed bottom-6 right-6 z-50 w-12 h-12 rounded-full bg-blue-600 hover:bg-blue-700 text-white shadow-lg transition-opacity duration-300 opacity-0 pointer-events-none flex items-center justify-center"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
  </div>

    <style is:global>
      /* 記事内画像の統一スタイル（アイキャッチ・本文内画像共通） */
      .post-image,
      article img {
        max-width: 100%;
        width: 100%;
        height: auto;
        display: block;
        margin: 0 auto 1.5rem auto;
        border-radius: 0.75rem; /* 12px */
        border: 1px solid #e2e8f0; /* slate-200 */
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1); /* shadow-sm */
      }
      :root[class~="dark"] .post-image,
      :root[class~="dark"] article img {
        border-color: #475569; /* slate-700 */
        object-fit: cover;
        aspect-ratio: 16 / 9;
      }

      /* ヒーロー画像は固定アスペクト比 */
      .post-image {
        aspect-ratio: 896 / 512;
      }

      /* 記事本文は左揃えにし、親のパディングに揃える */
      article {
        width: 100%;
        text-align: left;
        box-sizing: border-box;
        overflow-wrap: break-word;
        word-break: break-word;
      }

      /* 本文内アフィリエイトリンクのスタイル */
      article a[href*="amazon.co.jp"],
      article a[href*="rakuten.co.jp"] {
        color: #d97706 !important;
        font-weight: 600;
        text-decoration: underline !important;
        text-decoration-color: #fcd34d;
        text-underline-offset: 3px;
        transition: color 0.15s;
        pointer-events: auto !important;
        cursor: pointer;
        -webkit-tap-highlight-color: rgba(217, 119, 6, 0.2);
        touch-action: manipulation;
        display: inline;
      }
      article a[href*="amazon.co.jp"]:hover,
      article a[href*="rakuten.co.jp"]:hover {
        color: #b45309;
      }

      /* 本文内のHTMLブロック（アフィリエイトボックス等）のスタイル補正 */
      article div > a {
        pointer-events: auto !important;
        cursor: pointer;
        -webkit-tap-highlight-color: rgba(217, 119, 6, 0.2);
        touch-action: manipulation;
      }

      /* フォールバックセクション: 本文にアフィリエイトブロックがあれば非表示 */
      .affiliate-fallback {
        display: none;
      }

      /* TOC目次スタイル */
      .toc-link {
        display: block;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        border-left: 2px solid transparent;
      }
      .toc-link:hover {
        background-color: #f1f5f9;
      }
      :root[class~="dark"] .toc-link:hover {
        background-color: #334155;
      }
      .toc-link-active {
        color: #2563eb !important;
        border-left-color: #2563eb;
        background-color: #eff6ff;
        font-weight: 600;
      }
      :root[class~="dark"] .toc-link-active {
        background-color: #1e3a8a;
      }
      html {
        scroll-behavior: smooth;
      }

      /* コピーボタン */
      .copy-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        z-index: 10;
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1;
        border-radius: 0.375rem;
        border: 1px solid #475569;
        background-color: #1e293b;
        color: #cbd5e1;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.2s, background-color 0.2s;
      }
      .copy-btn:hover {
        background-color: #334155;
      }
      pre:hover .copy-btn,
      pre:focus-within .copy-btn {
        opacity: 1;
      }
      :root[class~="dark"] .copy-btn {
        background-color: #0f172a;
        border-color: #334155;
        color: #94a3b8;
      }
      :root[class~="dark"] .copy-btn:hover {
        background-color: #1e293b;
      }
      .copy-btn.copied {
        color: #4ade80;
        border-color: #4ade80;
      }
      pre {
        position: relative;
      }
    </style>

    <script is:inline>
      // Back to Top button
      (function() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        const toggle = () => {
          if (window.scrollY > 300) {
            btn.classList.remove('opacity-0', 'pointer-events-none');
            btn.classList.add('opacity-100', 'pointer-events-auto');
          } else {
            btn.classList.add('opacity-0', 'pointer-events-none');
            btn.classList.remove('opacity-100', 'pointer-events-auto');
          }
        };
        window.addEventListener('scroll', toggle, { passive: true });
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        toggle();
      })();

      document.addEventListener('DOMContentLoaded', () => {
        // TOC生成: 記事内のh2/h3を抽出して目次を構築
        const article = document.getElementById('article-content');
        const tocList = document.querySelector('.toc-list');
        if (article && tocList) {
          const headings = article.querySelectorAll('h2, h3, h4');
          if (headings.length > 0) {
            headings.forEach((heading, index) => {
              if (!heading.id) {
                heading.id = 'section-' + index;
              }
              const li = document.createElement('li');
              const a = document.createElement('a');
              a.href = '#' + heading.id;
              a.textContent = heading.textContent;
              a.className = 'toc-link hover:text-blue-600 transition-colors no-underline';
              const level = parseInt(heading.tagName.charAt(1));
              if (level === 3) {
                li.style.marginLeft = '1.25rem';
              } else if (level === 4) {
                li.style.marginLeft = '2.5rem';
              }
              li.appendChild(a);
              tocList.appendChild(li);
            });
          } else {
            document.querySelector('.toc-nav')?.remove();
          }
        }

        // 本文にアフィリエイトブロックがある場合、フォールバックセクションを表示
        const fallback = document.querySelector('.affiliate-fallback');
        if (article && fallback) {
          const hasAffiliate = article.querySelector('a[href*="amazon.co.jp"], a[href*="rakuten.co.jp"]');
          if (!hasAffiliate) {
            fallback.style.display = 'block';
          }
        }

        // アフィリエイトリンクのクリックトラッキング
        document.querySelectorAll('a[data-platform]').forEach(link => {
          link.addEventListener('click', (e) => {
            const platform = link.getAttribute('data-platform');
            const keyword = link.getAttribute('data-keyword');
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'affiliate_click', {
                'event_category': 'affiliate',
                'event_label': platform,
                'keyword': keyword
              });
            }
            console.log(`[Affiliate Click] platform=${platform} keyword=${keyword}`);
          });
        });

        // 本文内のアフィリエイトリンクもトラッキング
        document.querySelectorAll('article a[href*="amazon.co.jp"], article a[href*="rakuten.co.jp"]').forEach(link => {
          link.addEventListener('click', () => {
            const hostname = new URL(link.href, location.href).hostname;
            const platform = hostname.includes('amazon') ? 'amazon' : 'rakuten';
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'affiliate_click', {
                'event_category': 'affiliate_inline',
                'event_label': platform
              });
            }
            console.log(`[Affiliate Inline Click] platform=${platform} url=${link.href}`);
          });
        });

        // TOCリンクのスムーズスクロール
        document.querySelectorAll('.toc-link').forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = link.getAttribute('href').slice(1);
            const target = document.getElementById(targetId);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.replaceState(null, '', '#' + targetId);
            }
          });
        });

        // スクロール時に現在位置のTOCハイライト
        if (tocList && headings.length > 0) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              const link = tocList.querySelector('a[href="#' + entry.target.id + '"]');
              if (link) {
                if (entry.isIntersecting) {
                  tocList.querySelectorAll('.toc-link-active').forEach(l => l.classList.remove('toc-link-active'));
                  link.classList.add('toc-link-active');
                } else {
                  link.classList.remove('toc-link-active');
                }
              }
            });
          }, { rootMargin: '-80px 0px -80% 0px' });
          headings.forEach(h => observer.observe(h));
        }

        // コードブロックにコピーボタンを追加
        article?.querySelectorAll('pre').forEach(pre => {
          if (pre.querySelector('.copy-btn')) return;
          const btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.setAttribute('aria-label', 'コードをコピー');
          btn.textContent = 'コピー';
          pre.appendChild(btn);
          btn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code');
            const text = codeEl ? codeEl.textContent : pre.textContent;
            try {
              await navigator.clipboard.writeText(text);
              btn.textContent = 'Copied!';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.textContent = 'コピー';
                btn.classList.remove('copied');
              }, 2000);
            } catch {
              btn.textContent = '失敗';
              setTimeout(() => { btn.textContent = 'コピー'; }, 2000);
            }
          });
        });

        // 本文内の画像に lazy loading を追加（アイキャッチは除外）
        article?.querySelectorAll('img:not([loading])').forEach(img => {
          if (img.hasAttribute('fetchpriority')) return;
          img.setAttribute('loading', 'lazy');
        });
      });
    </script>
  </body>
</html>