---
// Giscus コメントウィジェット（GitHub Discussions バックエンド）
// 4 環境変数が揃って初めてスクリプトを出力。欠落時は何もしない（非表示・build 安全）。

const repo = (import.meta.env.PUBLIC_GISCUS_REPO || '').trim();
const repoId = (import.meta.env.PUBLIC_GISCUS_REPO_ID || '').trim();
const category = (import.meta.env.PUBLIC_GISCUS_CATEGORY || '').trim();
const categoryId = (import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || '').trim();

const isConfigured = Boolean(repo && repoId && category && categoryId);
---

{isConfigured && (
  <section id="comments" class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-700">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-1">コメント</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
      コメントを投稿するには <a href="https://github.com" class="underline text-blue-600 dark:text-blue-400">GitHub アカウント</a> が必要です。
      コメントは GitHub Discussions（<code class="text-xs">{repo}</code>）へ投稿されます。
    </p>
    <script
      id="giscus-script"
      src="https://giscus.app/client.js"
      crossorigin="anonymous"
      async
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-loading="lazy"
      data-lang="ja"
    />
    <script is:inline>
      (function () {
        const giscusScript = document.getElementById('giscus-script');
        if (!giscusScript) return;
        const syncTheme = () => {
          const isDark = document.documentElement.classList.contains('dark');
          giscusScript.setAttribute('data-theme', isDark ? 'dark' : 'light');
        };
        syncTheme();
        const observer = new MutationObserver(syncTheme);
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      })();
    </script>
  </section>
)}
