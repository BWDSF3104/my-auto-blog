---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="mt-16 pt-6 border-t border-slate-200 dark:border-slate-700 text-center text-sm text-slate-500 dark:text-slate-400">
  <p>&copy; {currentYear} BWD's AI Auto Blog. All rights reserved.</p>
  <nav class="mt-2 flex justify-center gap-4" aria-label="フッターナビ">
    <a href={baseUrl} class="text-blue-600 dark:text-blue-400 no-underline hover:underline">ホーム</a>
    <a href={`${baseUrl}/tags`} class="text-blue-600 dark:text-blue-400 no-underline hover:underline">タグ一覧</a>
    <a href={`${baseUrl}/about`} class="text-blue-600 dark:text-blue-400 no-underline hover:underline">About</a>
    <a href={`${baseUrl}/rss.xml`} class="text-blue-600 dark:text-blue-400 no-underline hover:underline">RSS</a>
  </nav>
  <div class="mt-4 flex justify-center gap-4">
    <a href="https://x.com/BWDSF3104" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors" aria-label="X (Twitter)" title="X (Twitter)">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.141 18.01H19.56l-14.15-18.01H5.86z"/></svg>
    </a>
