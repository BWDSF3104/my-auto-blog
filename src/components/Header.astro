---
interface Props {
  title?: string;
  subtitle?: string;
  isHomePage?: boolean;
}

const { title = "BWD's AI Auto Blog", subtitle = "Gemini API ＆ GitHub Actions による自動生成Blog", isHomePage = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// ヒーローセクションの統計情報
const postImports = import.meta.glob<{
  frontmatter: {
    pubDate: string;
    tags?: string[];
  };
}>('../content/posts/*.md', { eager: true });

const allTags = new Set<string>();
let latestDate = new Date(0);
Object.values(postImports).forEach((module: any) => {
  const fm = module.frontmatter;
  if (fm.tags) fm.tags.forEach((t: string) => allTags.add(t));
  const d = new Date(fm.pubDate);
  if (d > latestDate) latestDate = d;
});

const postCount = Object.values(postImports).length;
const tagCount = allTags.size;
const latestDateStr = latestDate > new Date(0) ? latestDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }) : '—';
---

<header class="mb-10">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">
        <a href={baseUrl} class="no-underline hover:opacity-80 transition-opacity">{title}</a>
      </h1>
    </div>
    <div class="flex items-center gap-2 sm:hidden">
      <button
        id="hamburger-btn"
        class="flex-shrink-0 p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-5 h-5 hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="w-5 h-5 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="hidden sm:flex items-center gap-2">
      <a
        href={`${baseUrl}/search`}
        class="flex-shrink-0 p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
        aria-label="検索"
        title="検索"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>
      <button
        id="dark-toggle"
        class="flex-shrink-0 p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
        aria-label="ダークモード切り替え"
        title="ダークモード切り替え"
      >
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden sm:hidden overflow-hidden transition-all duration-200"
    role="navigation"
    aria-labelledby="hamburger-btn"
  >
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg p-3 mb-4 space-y-1">
      <a
        href={`${baseUrl}/search`}
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 no-underline transition-colors"
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        検索
      </a>
      <button
        id="dark-toggle-mobile"
        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 no-underline transition-colors bg-transparent border-none cursor-pointer"
      >
        <svg class="w-5 h-5 flex-shrink-0 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg class="w-5 h-5 flex-shrink-0 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
        <span class="dark-mode-text">ダークモード</span>
      </button>
      <hr class="border-slate-200 dark:border-slate-700 my-1">
      <a
        href={baseUrl}
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 no-underline transition-colors"
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2 2H7a2 2 0 01-2-2V7m14 0a2 2 0 01-2-2H5a2 2 0 01-2 2m14 0v6a2 2 0 01-2 2H9a2 2 0 01-2-2V9m0 0h2m2 0h2"></path>
        </svg>
        記事一覧
      </a>
      <a
        href={`${baseUrl}/tags`}
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 no-underline transition-colors"
      >
        タグ一覧
      </a>
      <a
        href={`${baseUrl}/about`}
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 no-underline transition-colors"
      >
        About
      </a>
      <a
        href={`${baseUrl}/rss.xml`}
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 no-underline transition-colors"
      >
        RSS
      </a>
      <a
        href={`${baseUrl}/privacy`}
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 no-underline transition-colors"
      >
        Privacy
      </a>
    </div>
  </div>

  <div class="bg-gradient-to-r from-blue-600 to-indigo-700 dark:from-slate-800 dark:to-slate-900 rounded-xl p-4 sm:p-5 text-white shadow-md">
    <p class="text-sm sm:text-base font-medium mb-3">AI がトレンドを収集し、自動で記事を書くブログ。</p>

    <div class="grid grid-cols-3 gap-2 sm:gap-3 mb-3">
      <div class="text-center">
        <div class="text-lg sm:text-xl font-bold">{postCount}</div>
        <div class="text-[10px] sm:text-xs opacity-80">記事</div>
      </div>
      <div class="text-center">
        <div class="text-lg sm:text-xl font-bold">{tagCount}</div>
        <div class="text-[10px] sm:text-xs opacity-80">タグ</div>
      </div>
      <div class="text-center">
        <div class="text-[10px] sm:text-xs opacity-80">最新更新</div>
        <div class="text-xs sm:text-sm font-semibold mt-0.5">{latestDateStr}</div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
      <a
        href={isHomePage ? "#main-content" : baseUrl}
        class="inline-flex items-center justify-center px-4 py-1.5 bg-white/20 hover:bg-white/30 rounded-md text-xs sm:text-sm font-semibold no-underline transition-colors"
      >
        最新記事を読む
      </a>
      <a
        href={`${baseUrl}/tags`}
        class="inline-flex items-center justify-center px-4 py-1.5 bg-white/10 hover:bg-white/20 rounded-md text-xs sm:text-sm font-semibold no-underline transition-colors"
      >
        タグ一覧
      </a>
    </div>
  </div>
</header>

  <script is:inline>
(function(){
var h=document.documentElement;
function toggleDark(){var d=!h.classList.contains("dark");h.classList.toggle("dark",d);try{localStorage.setItem("theme",d?"dark":"light")}catch(e){}}
document.getElementById("dark-toggle")?.addEventListener("click",toggleDark);
document.getElementById("dark-toggle-mobile")?.addEventListener("click",toggleDark);
var hb=document.getElementById("hamburger-btn");
var mm=document.getElementById("mobile-menu");
var hi=mm?.parentElement?.querySelector(".hamburger-icon");
var ci=mm?.parentElement?.querySelector(".close-icon");
hb?.addEventListener("click",function(){
var open=hb.getAttribute("aria-expanded")==="true";
hb.setAttribute("aria-expanded",String(!open));
mm?.classList.toggle("hidden",open);
if(hi&&ci){hi.classList.toggle("hidden",!open);ci.classList.toggle("hidden",open)}
});
document.addEventListener("click",function(e){
if(!mm||!hb)return;
var target=e.target;
if(hb.getAttribute("aria-expanded")==="true"&&!mm.contains(target)&&!hb.contains(target)){
hb.setAttribute("aria-expanded","false");
mm.classList.add("hidden");
if(hi)hi.classList.remove("hidden");
if(ci)ci.classList.add("hidden");
}
});
})();
</script>